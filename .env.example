# LLM API Keys — set at least one
# The system auto-detects the first available provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: force a specific provider (openai / anthropic / google)
LLM_PROVIDER=

# Optional: override default models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_MODEL=gemini-2.0-flash
